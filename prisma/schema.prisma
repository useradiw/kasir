generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           String                @id @default(uuid())
  name         String
  categoryId   String
  price        Int
  isHidden     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  category     Category              @relation(fields: [categoryId], references: [id])
  variants     MenuVariant[]
  packageItems PackageItem[]
  orderItems   OrderItem[]
  onlinePrices MenuItemOnlinePrice[]
  recipes      Recipe[]

  @@map("menu_items")
}

model MenuVariant {
  id            String                @id @default(uuid())
  menuItemId    String
  label         String
  priceModifier Int                   @default(0)
  menuItem      MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  packageItems  PackageItem[]
  onlinePrices  MenuItemOnlinePrice[]
  recipes       Recipe[]

  @@map("menu_variants")
}

model Package {
  id           String        @id @default(uuid())
  name         String
  bundlePrice  Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packageItems PackageItem[]
  orderItems   OrderItem[]

  @@map("packages")
}

model PackageItem {
  id           String       @id @default(uuid())
  packageId    String
  menuItemId   String
  variantId    String?
  nameSnapshot String
  package      Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id])
  variant      MenuVariant? @relation(fields: [variantId], references: [id])

  @@unique([packageId, menuItemId, variantId])
  @@map("package_items")
}

// --- ORDERING & SESSIONS ---

model TableSession {
  id              String        @id @default(uuid())
  name            String
  service         ServiceEnum?
  externalOrderId String?
  customerAlias   String?
  customerPhone   String?
  ownerId         String?
  orderedAt       DateTime?
  servedAt        DateTime?
  paidAt          DateTime?
  erasedAt        DateTime?
  createdAt       DateTime      @default(now())
  owner           Staff?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  transactions    Transaction[]

  @@map("table_sessions")
}

model OrderItem {
  id             String          @id @default(uuid())
  tableSessionId String
  menuItemId     String?
  packageId      String?
  variantId      String?
  qty            Int             @default(1)
  note           String?
  status         OrderItemStatus @default(PENDING)
  nameSnapshot   String
  price          Int
  splitGroup     Int             @default(0)
  preparedAt     DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  tableSession   TableSession    @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?       @relation(fields: [menuItemId], references: [id])
  package        Package?        @relation(fields: [packageId], references: [id])
  variant        MenuVariant?    @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// --- FINANCE & TRANSACTIONS ---

model Transaction {
  id             String            @id @default(uuid())
  tableSessionId String
  processedById  String
  subtotal       Int
  taxAmount      Int               @default(0)
  serviceCharge  Int               @default(0)
  discountAmount Int               @default(0)
  totalAmount    Int
  cashAmount     Int               @default(0)
  qrisAmount     Int               @default(0)
  paymentMethod  PaymentMethod
  splitGroup     Int               @default(0)
  status         TransactionStatus @default(PAID)
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  paidAt         DateTime          @default(now())
  createdAt      DateTime          @default(now())
  tableSession   TableSession      @relation(fields: [tableSessionId], references: [id])
  processedBy    Staff             @relation("ProcessedTransactions", fields: [processedById], references: [id])
  voidedBy       Staff?            @relation("VoidedTransactions", fields: [voidedById], references: [id], onDelete: SetNull)
  cogs           Int?
  settlementItem SettlementItem?

  @@map("transactions")
}

model Expense {
  id               String        @id @default(uuid())
  description      String?
  recordedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  staffId          String?
  supplierId       String?
  deductFromCash   Boolean       @default(true)
  countToKasPakHar Boolean       @default(false)
  staff            Staff?        @relation(fields: [staffId], references: [id])
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items            ExpenseItem[]
  kasPakHarEntries KasPakHar[]

  @@map("expenses")
}

model ExpenseItem {
  id           String           @id @default(uuid())
  expenseId    String
  expense      Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description  String
  amount       Float
  cost         Int
  lineTotal    Int?             // exact total paid; old rows (null) fall back to amount * cost
  unit         String?
  templateId   String?          // legacy FK → ExpenseTemplate (kept until migration 2)
  template     ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ingredientId String?          // new FK → Ingredient
  ingredient   Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  purchase     IngredientPurchase?

  @@map("expense_items")
}

model CashRegister {
  id          String   @id @default(uuid())
  date        DateTime @unique
  openingCash Int      @default(0)
  closingCash Int?
  openedById  String?
  closedById  String?
  editedById  String?
  editedAt    DateTime?
  openedBy    Staff?   @relation("OpenedRegisters", fields: [openedById], references: [id])
  closedBy    Staff?   @relation("ClosedRegisters", fields: [closedById], references: [id])
  editedBy    Staff?   @relation("EditedRegisters", fields: [editedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cash_registers")
}

// --- SETTINGS ---

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// --- STAFF & ATTENDANCE ---

model Staff {
  id                  String             @id @default(uuid())
  username            String?            @unique
  name                String
  role                RoleEnum
  isActive            Boolean            @default(true)
  supabaseUserId      String?            @unique
  salary              Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  attendanceRecords   AttendanceRecord[]
  transactions        Transaction[]      @relation("ProcessedTransactions")
  voidedTransactions  Transaction[]      @relation("VoidedTransactions")
  tableSessions       TableSession[]
  openedRegisters     CashRegister[]     @relation("OpenedRegisters")
  closedRegisters     CashRegister[]     @relation("ClosedRegisters")
  editedRegisters     CashRegister[]     @relation("EditedRegisters")
  expenses            Expense[]
  notifications       Notification[]
  kasPakHarEntries    KasPakHar[]
  onlineSettlements   OnlineSettlement[] @relation("SettledOnlineOrders")
  stockOpnames        StockOpname[]

  @@map("staff")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  title       String
  body        String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   Staff            @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model AttendanceRecord {
  id       String           @id @default(uuid())
  staffId  String
  date     DateTime
  status   AttendanceStatus
  markedAt DateTime         @default(now())
  staff    Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("attendance_records")
}

// --- KAS PAK HAR ---

model KasPakHar {
  id          String        @id @default(uuid())
  date        DateTime      @default(now())
  type        KasPakHarType
  amount      Int
  description String?
  expenseId   String?
  expense     Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   Staff?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@map("kas_pak_har")
}

// --- ONLINE PRICING ---

model MenuItemOnlinePrice {
  id         String       @id @default(uuid())
  menuItemId String
  variantId  String?
  service    ServiceEnum
  price      Int
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant    MenuVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, variantId, service])
  @@map("menu_item_online_prices")
}

// --- ONLINE SETTLEMENT ---

model OnlineSettlement {
  id               String                @id @default(uuid())
  service          ServiceEnum
  settlementDate   DateTime              @default(now())
  totalGross       Int
  commissionAmount Int
  finalAmount      Int
  settledById      String
  notes            String?
  createdAt        DateTime              @default(now())
  settledBy        Staff                 @relation("SettledOnlineOrders", fields: [settledById], references: [id])
  items            SettlementItem[]
  deductions       SettlementDeduction[]

  @@index([service, settlementDate])
  @@map("online_settlements")
}

model SettlementItem {
  id            String           @id @default(uuid())
  settlementId  String
  transactionId String           @unique
  settlement    OnlineSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  transaction   Transaction      @relation(fields: [transactionId], references: [id])

  @@map("settlement_items")
}

model SettlementDeduction {
  id           String           @id @default(uuid())
  settlementId String
  label        String
  amount       Int
  settlement   OnlineSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@map("settlement_deductions")
}

// --- EXPENSE TEMPLATES (legacy — kept until migration 2) ---

model ExpenseTemplate {
  id                String             @id @default(uuid())
  name              String             @unique
  defaultUnit       String?
  defaultCost       Int?
  isActive          Boolean            @default(true)
  currentStock      Float              @default(0)
  lowStockAlert     Float?
  createdAt         DateTime           @default(now())
  expenseItems      ExpenseItem[]
  recipeIngredients RecipeIngredient[]
  ingredientLogs    IngredientLog[]

  @@map("expense_templates")
}

// --- SUPPLIERS ---

model Supplier {
  id                    String    @id @default(uuid())
  name                  String
  phone                 String?
  notes                 String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  expenses              Expense[]
  purchases             IngredientPurchase[]
  defaultForIngredients Ingredient[] @relation("DefaultSupplier")

  @@map("suppliers")
}

// --- INGREDIENTS (replaces ExpenseTemplate as the authoritative item master) ---

model Ingredient {
  id                String             @id @default(uuid())
  name              String             @unique
  category          IngredientCategory @default(BAHAN)
  unit              String             @default("pcs") @map("baseUnit")
  currentStock      Float              @default(0)
  unitCost          Float              @default(0) @map("averageUnitCost")
  lastUnitCost      Float?
  lastPurchasedAt   DateTime?
  lowStockAlert     Float?
  isActive          Boolean            @default(true)
  notes             String?
  defaultSupplierId String?
  defaultSupplier   Supplier?          @relation("DefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  tags              String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  purchases         IngredientPurchase[]
  recipeIngredients RecipeIngredient[]
  ingredientLogs    IngredientLog[]
  expenseItems      ExpenseItem[]
  opnameLines       StockOpnameLine[]
  producedRecipe    IngredientRecipe?      @relation("ProducedRecipe")
  componentOf       IngredientRecipeItem[] @relation("RecipeComponent")

  @@map("ingredients")
}

model IngredientPurchase {
  id            String                  @id @default(uuid())
  ingredientId  String
  ingredient    Ingredient              @relation(fields: [ingredientId], references: [id])
  supplierId    String?
  supplier      Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  expenseItemId String?                 @unique
  expenseItem   ExpenseItem?            @relation(fields: [expenseItemId], references: [id], onDelete: SetNull)
  source        IngredientPurchaseSource

  packLabel         String?
  packQty           Float
  baseQty           Float
  totalCost         Int
  unitCost          Float
  avgUnitCostAfter  Float
  stockAfter        Float

  purchasedAt   DateTime  @default(now())
  recordedById  String?
  notes         String?

  @@index([ingredientId, purchasedAt])
  @@map("ingredient_purchases")
}

// --- INGREDIENT RECIPES (a material assembled from other ingredients) ---

model IngredientRecipe {
  id           String     @id @default(uuid())
  ingredientId String     @unique
  ingredient   Ingredient @relation("ProducedRecipe", fields: [ingredientId], references: [id], onDelete: Cascade)
  yieldQty     Float      @default(1)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        IngredientRecipeItem[]

  @@map("ingredient_recipes")
}

model IngredientRecipeItem {
  id           String           @id @default(uuid())
  recipeId     String
  recipe       IngredientRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient       @relation("RecipeComponent", fields: [ingredientId], references: [id])
  quantity     Float

  @@map("ingredient_recipe_items")
}

// --- STOCK OPNAME ---

model StockOpname {
  id            String            @id @default(uuid())
  performedAt   DateTime          @default(now())
  performedById String?
  performedBy   Staff?            @relation(fields: [performedById], references: [id], onDelete: SetNull)
  notes         String?
  lines         StockOpnameLine[]

  @@index([performedAt])
  @@map("stock_opnames")
}

model StockOpnameLine {
  id           String      @id @default(uuid())
  opnameId     String
  opname       StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id])
  systemQty    Float
  countedQty   Float
  delta        Float
  noteReason   String?

  @@map("stock_opname_lines")
}

// --- RECIPES ---

model Recipe {
  id          String             @id @default(uuid())
  menuItemId  String
  variantId   String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant     MenuVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@unique([menuItemId, variantId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String           @id @default(uuid())
  recipeId     String
  templateId   String?          // legacy FK → ExpenseTemplate (kept until migration 2)
  customName   String?
  customUnit   String?
  quantity     Float
  ingredientId String?          // new FK → Ingredient
  recipe       Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  template     ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ingredient   Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@map("recipe_ingredients")
}

// --- INGREDIENT STOCK LEDGER ---

model IngredientLog {
  id           String            @id @default(uuid())
  templateId   String?           // legacy FK → ExpenseTemplate (nullable after migration 1)
  template     ExpenseTemplate?  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ingredientId String?           // new FK → Ingredient
  ingredient   Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Float
  unitCost     Float
  referenceId  String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([ingredientId, createdAt])
  @@index([templateId, createdAt])
  @@map("ingredient_logs")
}

// --- ENUMS ---

enum IngredientCategory {
  BAHAN
  KEMASAN
  PERLENGKAPAN
  LAINNYA
}

enum IngredientPurchaseSource {
  EXPENSE
  ADJUSTMENT
  OPNAME_GAIN
  ASSEMBLY
}

enum ServiceEnum {
  GoFood
  ShopeeFood
  GrabFood
  Take_Away
  Unknown
}

enum OrderItemStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  SPLIT
  PENDING
}

enum TransactionStatus {
  PAID
  VOIDED
}

enum RoleEnum {
  OWNER
  MANAGER
  CASHIER
  STAFF
  DEVELOPER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NotificationType {
  TRANSACTION_VOIDED
  SESSION_VOIDED
  TEST
}

enum KasPakHarType {
  DEPOSIT
  WITHDRAWAL
  EXPENSE_DEDUCTION
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  ASSEMBLY
}

// ===== Warung Books (double-entry ledger) =====
// The financial brain layered on top of operations. Amounts are BigInt signed
// Rupiah (positive = debit, negative = credit); existing Int money columns are
// left untouched and cast at the seam. Nothing here references or alters an
// existing table — linkage to operational rows goes through LedgerPosting only.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum EntryState {
  DRAFT
  POSTED
  VOID
}

enum ExpenseBucket {
  HPP
  OPEX
}

/// Chart-of-accounts registry (Beancount-style names, e.g. "Assets:Cash:Utama").
/// Deliberately NOT FK'd from JournalLine — lines carry the account name string;
/// this table backs UI dropdowns / validation. Named LedgerAccount to avoid the
/// existing Better Auth `Account` model / `accounts` table.
model LedgerAccount {
  id       String          @id @default(cuid())
  code     String          @unique
  name     String          @unique
  // Friendly display label for dropdowns, e.g. "Kas Laci Toko" / "Bank BCA".
  // Falls back to the account name's last segment when null.
  label    String?
  type     AccountType
  parentId String?
  parent   LedgerAccount?  @relation("LedgerAccountParent", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("LedgerAccountParent")
  active   Boolean         @default(true)

  @@map("ledger_accounts")
}

model JournalEntry {
  id        String     @id @default(cuid())
  // Gapless human number, null while DRAFT; assigned atomically at POST.
  number    Int?
  state     EntryState @default(DRAFT)
  date      String // ISO date string, e.g. "2024-01-15"
  narration String
  postedAt  DateTime?
  createdAt DateTime   @default(now())

  // Self-relation for VOID reversal links.
  reversedById String?       @unique
  reversedBy   JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reverses     JournalEntry? @relation("Reversal")

  lines JournalLine[]

  // Guided-screen tagging (additive, nullable). sourceType is a free-form string
  // ("pengeluaran" | "transfer" | "modal" | "prive" | "saldo-awal"); sourceMeta
  // stashes the form fields list views render without a parallel event table.
  sourceType String?
  sourceMeta Json?

  @@map("journal_entries")
}

model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id])
  // Beancount-style account name; matches the core JournalLine.account string.
  account String
  // Signed Rupiah: positive = debit, negative = credit.
  amount  BigInt

  @@map("journal_lines")
}

/// Cek Saldo: an asserted real-world cash balance for a kas account on a date.
/// The comparison against the derived ledger balance is computed at render,
/// NEVER stored.
model BalanceAssertion {
  id        String   @id @default(cuid())
  account   String // Beancount-style kas account, e.g. "Assets:Cash:Utama"
  date      String // ISO "YYYY-MM-DD"
  expected  BigInt // Saldo diharapkan — integer Rupiah
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([account, date])
  @@map("balance_assertions")
}

/// Pengeluaran categories. code is uppercase and immutable after create
/// (enforced at the repository level).
model ExpenseCategory {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  bucket    ExpenseBucket
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("expense_categories")
}

/// Gapless sequence counter (one row per scope, e.g. key="journal").
model Sequence {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)

  @@map("sequences")
}

/// Accounting months (Bulan). The user creates the periods they operate in and
/// picks the active one across the Keuangan screens (Warung Books hardcoded these).
/// `lockedAt` backs Slice 5 tutup buku (month lock) — nullable, unused until then.
model AccountingMonth {
  id        String    @id @default(cuid())
  month     String    @unique // "YYYY-MM"
  lockedAt  DateTime?
  createdAt DateTime  @default(now())

  @@map("accounting_months")
}

/// Sales channel → kas account mapping. Each sale's cash leg is debited to the
/// account mapped for its channel. Channels: "tunai" (cash), "elektronik"
/// (QRIS/debit/kredit/transfer), "online" (webstore orders — n/a for kasir today).
/// `account` is a Beancount cash-account name from the LedgerAccount registry.
model SalesChannelAccount {
  id        String   @id @default(cuid())
  channel   String   @unique // "tunai" | "elektronik" | "online"
  account   String // Beancount cash account, e.g. "Assets:Cash:KasLaci"
  updatedAt DateTime @updatedAt

  @@map("sales_channel_accounts")
}

/// Generic key/value settings for Warung Books config. Today holds a single
/// key, "purchase-cash-account" — the Beancount kas account name that bahan
/// baku purchases (pengeluaran) are paid from (Expenses:HPP:Bahan leg's
/// counterpart).
model AccountingSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("accounting_settings")
}

/// The correlation table — the linkage pattern. Ties a WB JournalEntry back to
/// the operational row (KasirTransaction / Pengeluaran / shift close) that
/// caused it WITHOUT touching that row. The unique constraint gives idempotency
/// (one live posting per source doc); reversal state is tracked here, not on
/// the source table.
model LedgerPosting {
  id             String   @id @default(cuid())
  sourceType     String // "kasir" | "pengeluaran" | "shift-close"
  sourceId       String // the existing KasirTransaction/Pengeluaran/session id
  journalEntryId String // the WB JournalEntry id
  createdAt      DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@index([journalEntryId])
  @@map("ledger_postings")
}
